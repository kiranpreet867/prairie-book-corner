<h1><%= @product.name %></h1>

<%= link_to "Shopping Cart", cart_path %>

<p class="breadcrumb">
  <%= link_to "Home", root_path %>
  &raquo;
  <%= link_to @product.category.name, category_path(@product.category) %>
  &raquo;
  <span><%= @product.name %></span>
</p>

<% if @product.image.attached? %>
  <%= image_tag @product.image.variant(resize_to_limit: [400, 400]) %>
<% end %>

<%= button_to "Add to Cart",
              add_to_cart_path(@product),
              method: :post,
              class: "btn btn-primary" %>

<p>
  <strong>Description:</strong><br>
  <%= @product.description %>
</p>

<p>
  <strong>Category:</strong>
  <%= @product.category.name %>
</p>

<p>
  <strong>Price:</strong>
  <%= number_to_currency(@product.price) %>
</p>

<p>
  <strong>Stock:</strong>
  <%= @product.stock_quantity %>
</p>

<p>
  <%= link_to "← Back to All Products", root_path %>
</p>