<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prairie Book Corner" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
  <%= link_to "Store", root_path %>
  |
  <%= link_to "Shopping Cart", cart_path %>
  |

  <% if customer_signed_in? %>
    Signed in as <strong><%= current_customer.username %></strong>
    |
    <%= button_to "Log Out",
                  destroy_customer_session_path,
                  method: :delete,
                  form: { style: "display:inline-block;" } %>
  <% else %>
    <%= link_to "Customer Sign Up",
                new_customer_registration_path %>
    |
    <%= link_to "Customer Login",
                new_customer_session_path %>
  <% end %>
</nav>

<hr>

    <% flash.each do |type, message| %>
      <div class="alert alert-success">
        <p><%= message %></p>
      </div>
    <% end %>

    <%= yield %>

  </body>
</html>